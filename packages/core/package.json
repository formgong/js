{
  "name": "@formgong/core",
  "version": "0.1.0",
  "description": "Tiny, typed, zero-dependency client for Formgong, the form backend for contact forms: submissions go to email, Telegram and webhooks. Browser, Node, Deno, Bun and edge. A Formspree / Web3Forms alternative.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./api": {
      "import": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      },
      "require": {
        "types": "./dist/api.d.cts",
        "default": "./dist/api.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "formgong",
    "form-backend",
    "form backend",
    "contact-form",
    "contact form",
    "forms",
    "form-submission",
    "formspree-alternative",
    "formspree alternative",
    "web3forms-alternative",
    "web3forms alternative",
    "getform-alternative",
    "telegram",
    "email",
    "webhooks",
    "gdpr",
    "spam-protection",
    "honeypot",
    "serverless",
    "edge",
    "cloudflare-workers",
    "nextjs",
    "react",
    "vue",
    "svelte",
    "astro",
    "lovable",
    "bolt",
    "v0",
    "static-site",
    "no-backend",
    "typescript"
  ],
  "author": "Formgong <support@formgong.com>",
  "license": "MIT",
  "homepage": "https://formgong.com/en/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formgong/js.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/formgong/js/issues",
    "email": "support@formgong.com"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
