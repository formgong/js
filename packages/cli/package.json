{
  "name": "formgong",
  "version": "0.2.0",
  "description": "Formgong CLI: create a form backend and add a working contact form to Next.js, React, Vue, Svelte, Astro or plain HTML in one command. Submissions go to email and Telegram. npx formgong init",
  "type": "module",
  "bin": {
    "formgong": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@formgong/core": "workspace:^"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "formgong",
    "cli",
    "contact-form",
    "contact form",
    "form-backend",
    "form backend",
    "forms",
    "form-builder",
    "formspree-alternative",
    "formspree alternative",
    "web3forms-alternative",
    "web3forms alternative",
    "telegram",
    "email",
    "gdpr",
    "nextjs",
    "react",
    "vue",
    "svelte",
    "astro",
    "lovable",
    "bolt",
    "v0",
    "mcp",
    "ai-agents",
    "no-backend"
  ],
  "author": "Formgong <support@formgong.com>",
  "license": "MIT",
  "homepage": "https://formgong.com/en/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formgong/js.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/formgong/js/issues",
    "email": "support@formgong.com"
  },
  "publishConfig": {
    "access": "public"
  }
}
