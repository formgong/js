{
  "name": "@formgong/vue",
  "version": "0.1.0",
  "description": "Vue 3 / Nuxt contact form without a backend: <ContactForm>, <FormgongForm> and useFormgong(). Submissions go to email, Telegram and webhooks via Formgong. A Formspree / Web3Forms alternative.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": { "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2020", "typecheck": "tsc --noEmit", "test": "vitest run" },
  "dependencies": { "@formgong/core": "workspace:^" },
  "peerDependencies": { "vue": ">=3.3" },
  "devDependencies": { "vue": "^3.5.13" },
  "keywords": [
    "formgong", "vue", "vue3", "nuxt", "composable", "contact-form", "contact form", "form-backend", "form backend", "forms",
    "formspree-alternative", "formspree alternative", "web3forms-alternative", "web3forms alternative",
    "telegram", "email", "gdpr", "spam-protection", "lovable", "bolt", "static-site", "no-backend"
  ],
  "author": "Formgong <support@formgong.com>",
  "license": "MIT",
  "homepage": "https://formgong.com/en/docs/",
  "repository": { "type": "git", "url": "git+https://github.com/formgong/js.git", "directory": "packages/vue" },
  "bugs": { "url": "https://github.com/formgong/js/issues", "email": "support@formgong.com" },
  "publishConfig": { "access": "public", "provenance": true }
}
