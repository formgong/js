{
  "name": "@formgong/next",
  "version": "0.1.0",
  "description": "Next.js contact forms with Formgong: Server Action helper (useActionState), Route Handler helper and App Router client components. Submissions go to email, Telegram and webhooks. A Formspree / Web3Forms alternative.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./server": {
      "import": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
      "require": { "types": "./dist/server.d.cts", "default": "./dist/server.cjs" }
    },
    "./client": {
      "import": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
      "require": { "types": "./dist/client.d.cts", "default": "./dist/client.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": { "build": "tsup", "typecheck": "tsc --noEmit", "test": "vitest run" },
  "dependencies": { "@formgong/core": "workspace:^", "@formgong/react": "workspace:^" },
  "peerDependencies": { "next": ">=14", "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "formgong", "nextjs", "next.js", "next", "server-actions", "server action", "useActionState", "app-router", "route-handler",
    "contact-form", "contact form", "form-backend", "form backend", "forms", "react",
    "formspree-alternative", "formspree alternative", "web3forms-alternative", "web3forms alternative",
    "telegram", "email", "gdpr", "vercel", "lovable", "bolt", "v0", "no-backend"
  ],
  "author": "Formgong <support@formgong.com>",
  "license": "MIT",
  "homepage": "https://formgong.com/en/docs/",
  "repository": { "type": "git", "url": "git+https://github.com/formgong/js.git", "directory": "packages/next" },
  "bugs": { "url": "https://github.com/formgong/js/issues", "email": "support@formgong.com" },
  "publishConfig": { "access": "public", "provenance": true }
}
