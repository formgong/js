{
  "name": "formgong-js",
  "private": true,
  "description": "Official JavaScript SDKs for Formgong, the form backend that delivers submissions to email, Telegram and webhooks.",
  "license": "MIT",
  "author": "Formgong <support@formgong.com>",
  "homepage": "https://formgong.com/en/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formgong/js.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "test:e2e": "node scripts/e2e.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
